{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/omr-worker.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {"src": "/api/omr-worker", "dest": "/api/omr-worker.py"},
    {"src": "/api/(.*)", "dest": "/api/[...path]"},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
